# Copy to .env.local (gitignored) for `pnpm dev`. All values are public and end up in browser code;
# in CI/production they come from GitHub repository *Variables* (not Secrets), see docs/DEPLOYMENT.md.
# If any of the three contact values is missing, the contact form falls back to a mailto: link.

# Canonical site URL used for metadata (optional locally).
# NEXT_PUBLIC_SITE_URL=https://castiarena.github.io

# Contact form → castiarena/email-api (POST {url}/api/send). No trailing slash (one is stripped anyway).
NEXT_PUBLIC_EMAIL_API_URL=https://email-api-agustin-castiarenas-projects.vercel.app

# Public key (pk_live_…). The API locks it to allowed origins, the `contact` template and a fixed
# recipient. Local dev needs http://localhost:3000 in that key's origins.
NEXT_PUBLIC_EMAIL_API_KEY=

# Cloudflare Turnstile *site* key (never the secret). Local dev against the real API needs the REAL
# site key with `localhost` in the widget's hostnames: the test key 1x00000000000000000000AA produces
# dummy tokens that the production secret rejects. Use the test key only in automated tests.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
